# ═══════════════════════════════════════════════════════════════════════════
# UnivReq — configuration Docker de PRODUCTION
# Copier vers .env à la racine puis adapter :  cp .env.production.example .env
# docker compose lit ce fichier (interpolation ${...}) et injecte les valeurs
# dans les conteneurs via le bloc `environment:` du docker-compose.yml.
# ═══════════════════════════════════════════════════════════════════════════

# ── Sécurité ───────────────────────────────────────────────────────────────
# Génération : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# ── Domaine public ─────────────────────────────────────────────────────────
# Domaine pointé vers le VPS (sans scheme) + origines CSRF complètes.
ALLOWED_HOSTS=univreq.example.com
CSRF_TRUSTED_ORIGINS=https://univreq.example.com

# ── Base PostgreSQL (conteneur univreq_db, isolé de toutes les autres apps) ─
DB_NAME=univreq
DB_USER=univreq
DB_PASSWORD=

# ── Port applicatif ────────────────────────────────────────────────────────
# Pubié uniquement sur 127.0.0.1 — Caddy reverse_proxie vers localhost:8010.
# Changer ici si le port est déjà pris par une autre app du VPS.
UNIVREQ_HTTP_PORT=8010

# ── Web Push (optionnel) ───────────────────────────────────────────────────
# Génération : uv run python -m py_vapid generate --applicationServerKey
# Sans clés, le Web Push est désactivé (WebSockets restent actifs).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=admin@univ.example

# ── Divers ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
TZ=UTC
