# =========================================================================== #
# UnivReq — modèle de configuration (copier vers .env puis adapter)
# Priorité : variables système > ce fichier (python-decouple)
# =========================================================================== #

# ── Environnement ───────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=change-me-generate-with-django-secret-key-generator
ALLOWED_HOSTS=example.univ.edu
CSRF_TRUSTED_ORIGINS=https://example.univ.edu

# ── Base de données ─────────────────────────────────────────────────────────
# DEV : sqlite (défaut)   |   PROD : postgresql
DB_ENGINE=postgresql
DB_NAME=univreq
DB_USER=univreq
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ── Temps réel (Django Channels) ────────────────────────────────────────────
# True obligatoire en production (au moins 1 worker dédié daphne/uvicorn)
USE_REDIS_CHANNEL_LAYER=True
REDIS_URL=redis://127.0.0.1:6379/0

# ── Sécurité / production ───────────────────────────────────────────────────
SECURE_COOKIES=True
# True si HTTPS terminé derrière le reverse-proxy
SECURE_SSL_REDIRECT=False

# ── Divers ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Mot de passe temporaire généré par l'import ETL ({matricule} et {year} injectés)
IMPORT_DEFAULT_PASSWORD_PATTERN={matricule}Univ!{year}
# Espace enseignant : demande d'informations complémentaires (MORE_INFO)
ENABLE_TEACHER_MORE_INFO=True

# ── Web Push (VAPID) — paires de clés par environnement ─────────────────────
# Génération : uv run python -m py_vapid generate --applicationServerKey
# Sans clés, le Web Push est désactivé (les WebSockets restent actifs).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=admin@univ.example


# E-mail transactionnel — liens de première connexion / mot de passe oublié
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=UnivReq <no-reply@univ.example>
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Liens à usage unique (validité en heures)
ACCESS_LINK_TTL_HOURS=48
RESET_LINK_TTL_HOURS=4
# Segment enseignant des matricules (CM-UDS-22ENS0001)
TEACHER_MATRICULE_SEGMENT=ENS
# Origine des liens envoyés par e-mail (liens absolus et cliquables)
SITE_URL=https://univreq.example.cm
